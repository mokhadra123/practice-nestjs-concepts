<% const signedInAt = today.toLocaleString('en-US', { dateStyle: 'full', timeStyle: 'short' }); -%>
<!DOCTYPE html>
  <html lang="en">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>New sign-in</title>
    </head>
    <body style="margin:0; padding:0; background-color:#f4f5f7; font-family:Arial, Helvetica, sans-serif;">

      <!-- Preheader: shows in the inbox preview, hidden in the body -->
      <div style="display:none; max-height:0; overflow:hidden; opacity:0;">
        Your account was signed in on <%= signedInAt %>.
      </div>

      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4f5f7;">
        <tr>
          <td align="center" style="padding:32px 16px;">

            <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; width:100%; background-color:#ffffff; border-radius:8px; overflow:hidden;">

              <!-- Header -->
              <tr>
                <td style="background-color:#0b6e63; padding:24px 32px;">
                  <h1 style="margin:0; font-size:20px; line-height:1.3; color:#ffffff; font-weight:bold;">
                    New sign-in detected
                  </h1>
                </td>
              </tr>

              <!-- Body -->
              <tr>
                <td style="padding:32px;">
                  <p style="margin:0 0 16px; font-size:16px; line-height:1.6; color:#1f2933;">
                    Hi <%= user.username %>,
                  </p>
                  <p style="margin:0 0 24px; font-size:16px; line-height:1.6; color:#1f2933;">
                    Your account was just signed in. If this was you, no action is needed.
                  </p>

                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                         style="background-color:#f4f5f7; border-radius:6px; margin-bottom:24px;">
                    <tr>
                      <td style="padding:16px 20px; font-size:14px; line-height:1.7; color:#52606d;">
                        <strong style="color:#1f2933;">Account:</strong> <%= user.email %><br />
                        <strong style="color:#1f2933;">Time:</strong> <%= signedInAt %>
                      </td>
                    </tr>
                  </table>

                  <p style="margin:0 0 24px; font-size:14px; line-height:1.6; color:#52606d;">
                    Didn't sign in? Reset your password right away and review your recent activity.
                  </p>

                  <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td style="background-color:#0b6e63; border-radius:6px;">
                        <a href="https://your-domain.com/reset-password"
                           style="display:inline-block; padding:12px 28px; font-size:15px; font-weight:bold; color:#ffffff; text-decoration:none;">
                          Reset password
                        </a>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>

              <!-- Footer -->
              <tr>
                <td style="padding:20px 32px; border-top:1px solid #e4e7eb;">
                  <p style="margin:0; font-size:12px; line-height:1.6; color:#9aa5b1;">
                    This is an automated message — please don't reply.
                  </p>
                </td>
              </tr>

            </table>
          </td>
        </tr>
      </table>
    </body>
  </html>